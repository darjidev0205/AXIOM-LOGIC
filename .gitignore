# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output ─────────────────────────────────────────────────────────────
.next/
/out/
/build/
/dist/

# ── Environment variables (NEVER commit real secrets) ────────────────────────
.env
.env.*
!.env.example

# ── Vercel ───────────────────────────────────────────────────────────────────
.vercel/

# ── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Prisma generated (client is generated on deploy) ─────────────────────────
# DO NOT ignore prisma/schema.prisma — it must be committed
# DO NOT ignore prisma/migrations — they must be committed

# ── Testing ──────────────────────────────────────────────────────────────────
/coverage/

# ── OS & editor metadata ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Certificates & keys ───────────────────────────────────────────────────────
*.pem
*.key
*.cert

# ── Temporary / scratch files ─────────────────────────────────────────────────
tmp/
temp/
scratch_crops/

# ── Debug / dump files ────────────────────────────────────────────────────────
*.dump
*.trace
