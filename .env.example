# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Transaction pooler for runtime queries, e.g., Supabase port 6543 with ?pgbouncer=true)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true

# Direct connection string for Prisma migrations & schema engine (e.g., Supabase direct port 5432)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE


# ── Application ───────────────────────────────────────────────────────────────
# Full public URL of the deployed frontend (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# ── Authentication ────────────────────────────────────────────────────────────
# HMAC signing secret — generate with: openssl rand -hex 64
# REQUIRED. App will refuse to start without this.
AUTH_SECRET=

# ── AI Providers (optional — mock responses used when missing) ────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Automation (optional) ─────────────────────────────────────────────────────
N8N_WEBHOOK_URL=
N8N_BOOKING_WEBHOOK_URL=
N8N_API_KEY=

# ── Email — Resend (server-side only, NEVER prefix with NEXT_PUBLIC_) ─────────
# Sign up at https://resend.com — emails gracefully fail when missing
RESEND_API_KEY=

# ── Integrations (optional) ───────────────────────────────────────────────────
CALENDAR_API_KEY=
SLACK_BOT_TOKEN=
WHATSAPP_API_TOKEN=
